{
  "name": "mukhdar",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test \"scripts/**/*.test.mjs\"",
    "sb": "node scripts/sb.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:test:remote": "node scripts/db-test.mjs --remote",
    "db:concurrency": "node scripts/db-concurrency.mjs",
    "db:report-perf": "node scripts/report-perf.mjs",
    "load:run": "node scripts/load/run.mjs",
    "load:cleanup": "node scripts/load/cleanup.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:reset": "node scripts/seed-reset.mjs",
    "demo:rotate": "node scripts/rotate-demo-creds.mjs",
    "dev:cancel-stale-orders": "node scripts/dev-cancel-stale-orders.mjs",
    "supabase": "supabase",
    "test:functions": "deno check --config supabase/functions/deno.json supabase/functions/push-dispatch/index.ts supabase/functions/delete-account/index.ts supabase/functions/signup/index.ts supabase/functions/admin-reset-pin/index.ts supabase/functions/admin-create-user/index.ts supabase/functions/driver-register/index.ts supabase/functions/driver-complete-registration/index.ts && deno test --no-prompt --allow-read=supabase/functions,supabase/migrations --config supabase/functions/deno.json supabase/functions",
    "it:delete-account": "node scripts/delete-account-it.mjs",
    "it:signup": "node scripts/signup-it.mjs",
    "it:driver-register": "node scripts/driver-register-it.mjs",
    "it:admin-users": "node scripts/admin-users-it.mjs",
    "it:break-glass": "node scripts/admin-break-glass-it.mjs",
    "admin:break-glass-reset": "node scripts/admin-break-glass.mjs",
    "product-images": "node scripts/product-images/run.mjs",
    "hide-products": "node scripts/hide-products.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
