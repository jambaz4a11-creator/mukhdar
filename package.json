{
  "name": "mukhdar",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test \"scripts/**/*.test.mjs\"",
    "db:test": "node scripts/db-test.mjs",
    "db:test:remote": "node scripts/db-test.mjs --remote",
    "db:concurrency": "node scripts/db-concurrency.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:reset": "node scripts/seed-reset.mjs",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
